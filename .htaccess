# Retera 製品サイト — Apache 用の最小設定（2026-08-10）
#
# ⚠️ このファイルは Apache のときだけ効きます。
#    レンタルサーバ（さくら・エックスサーバー・ロリポップ等）はほぼ Apache なので、
#    site/ の中身と一緒にアップロードすれば 404 ページが有効になります。
#    nginx や GitHub Pages の場合は別の設定が必要です（GitHub Pages は 404.html を自動で使います）。

# --- 404 ページ ---
ErrorDocument 404 /404.html

# --- 文字コード ---
AddDefaultCharset UTF-8

# --- 公開までの間、検索避けを HTTP ヘッダーでも念のため付ける ---
# ⚠️ 公開時には、この 3 行と各 HTML の <meta name="robots"> を一緒に外すこと。
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# --- 画像・CSS のキャッシュ（更新時はファイル名を変えるか、この行を外す）---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType text/css  "access plus 1 days"
</IfModule>
